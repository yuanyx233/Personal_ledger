# PUBLIC CLIENT CONFIGURATION ONLY.
# Every VITE_* value is embedded in the browser bundle; never add credentials here.
VITE_API_BASE_PATH="/api/v1"
VITE_APP_TIMEZONE="America/Toronto"
# The currencies your accounts are denominated in, comma separated.
# Cross-border spending arrives already converted by your card issuer, so this is
# not every currency you might encounter. Each must have a 1/100 minor unit.
VITE_LEDGER_CURRENCIES="CAD,USD"
