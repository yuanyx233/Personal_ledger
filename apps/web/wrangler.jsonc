{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "personal-ledger-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "vars": {
    "APP_TIMEZONE": "America/Toronto",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-ledger-production",
      // Replaced only during the separately authorized deployment task.
      "database_id": "908a378d-e83b-4dac-9808-b5a0476016ef",
      "migrations_dir": "../../migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  // Required values are loaded from .dev.vars locally and encrypted Worker secrets in production.
  // Source: https://developers.cloudflare.com/workers/configuration/secrets/
  "secrets": {
    "required": ["ACCESS_AUD", "ACCESS_TEAM_DOMAIN", "CSRF_HMAC_KEY", "OWNER_EMAIL"],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Keep every app/static request on the Worker authentication boundary.
    // Source: https://developers.cloudflare.com/workers/static-assets/routing/worker-script/
    "run_worker_first": true,
  },
}
