{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "personal-ledger-sync",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "vars": {
    "APP_TIMEZONE": "America/Toronto",
    "PLAID_ENV": "sandbox",
    "SCHEDULED_SYNC_MAX_ITEMS": "2",
    "SCHEDULED_SYNC_MAX_PAGES": "20",
    "SCHEDULED_SYNC_MAX_RUNTIME_MS": "20000",
    "SYNC_STALE_AFTER_MINUTES": "60",
  },
  "triggers": {
    "crons": ["*/30 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-ledger",
      // Replaced only during the separately authorized deployment task.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "WEBHOOK_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": ["PLAID_CLIENT_ID", "PLAID_SECRET", "PLAID_TOKEN_ENCRYPTION_KEY"],
  },
}
